# Template — copy to .env and fill in. NEVER commit .env (it's gitignored).
#
# Example: `cp deploy/jupyterhub/.env.example deploy/jupyterhub/.env`
# Then edit .env to set the real values.

# === JupyterHub admins (auto-approved on signup) ===
JUPYTERHUB_ADMIN_USERS=admin

# === Hub host port (set to 127.0.0.1:8000:8000 in compose if using Caddy) ===
HUB_PORT=8000

# === Image to spawn for each logged-in user ===
DOCKER_SPAWN_IMAGE=ghcr.io/uw-madison-dsi/exsoil-nsf-prototype-refactor:latest

# === Per-user resource limits ===
JUPYTERHUB_MEM_LIMIT=4G
JUPYTERHUB_CPU_LIMIT=2

# ===========================================
# HTTPS / Let's Encrypt (only used when Caddy is enabled)
# ===========================================
ACME_EMAIL=you@example.com
DOMAIN=jupyter.example.com

# ===========================================
# Secrets — fill in for your deployment.
# These are passed through to user containers so the notebooks can
# reach S3 / OpenAI without manual setup per session.
# ===========================================
COS_ACCESS_KEY_ID=
COS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
OPENAI_API_KEY=
JUPYTER_TOKEN=
